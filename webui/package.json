{
  "name": "webui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm test:logic && pnpm test:components",
    "test:logic": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:components": "vitest run",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "@nuxt/ui": "^4.11.3",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "d3-cloud": "^1.2.9",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12"
  }
}
