# Copy this file to .env.rsshub and uncomment only the credentials you use.
# Never commit .env.rsshub; these values grant access to your accounts.

# X Web API (recommended): x.com login Cookie named auth_token.
# TWITTER_AUTH_TOKEN=replace-with-x-auth-token

# If the RSSHub container cannot reach X directly, proxy only X-related hosts.
# PROXY_URI=http://host.docker.internal:7890
# PROXY_STRATEGY=all
# PROXY_URL_REGEX=^https?://([^/]+\.)?(x\.com|twitter\.com|twimg\.com)(/|$)

# X Developer API alternative (do not combine with TWITTER_AUTH_TOKEN).
# TWITTER_CONSUMER_KEY=replace-with-api-key
# TWITTER_CONSUMER_SECRET=replace-with-api-secret

# Optional Bilibili fallback when Chromium still meets source-site risk control.
# Replace 123456 with the UID of the logged-in Bilibili account and copy the
# complete Cookie request header, not only SESSDATA.
# BILIBILI_COOKIE_123456="SESSDATA=...; bili_jct=...; DedeUserID=..."
